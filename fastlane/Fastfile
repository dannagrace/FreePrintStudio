require "shellwords"

PROJECT_ROOT = File.expand_path("..", __dir__)
APP_IDENTIFIER = "com.dannagrace.FreePrintStudio"
APP_VERSION = "1.0"
PRIMARY_CATEGORY = "Graphics & Design"
SECONDARY_CATEGORY = "Productivity"
DEFAULT_EXPORT_PATH = File.join(PROJECT_ROOT, "build/AppStoreExport")
REVIEW_INFORMATION_PATH = File.join(PROJECT_ROOT, "fastlane/metadata/review_information")
APP_PRIVACY_DETAILS_PATH = File.join(PROJECT_ROOT, "AppStore/app_privacy_details.json")

def app_store_connect_credentials(required: false)
  api_key_json = ENV["APP_STORE_CONNECT_API_KEY_JSON"].to_s
  unless api_key_json.empty?
    UI.user_error!("APP_STORE_CONNECT_API_KEY_JSON does not exist: #{api_key_json}") if required && !File.file?(api_key_json)
    return File.file?(api_key_json) ? { api_key_path: api_key_json } : {}
  end

  key_id = ENV["ASC_KEY_ID"].to_s
  issuer_id = ENV["ASC_ISSUER_ID"].to_s
  key_path = ENV["ASC_KEY_PATH"].to_s

  if key_id.empty? || issuer_id.empty? || key_path.empty?
    if required
      UI.user_error!(
        "Set APP_STORE_CONNECT_API_KEY_JSON, or set ASC_KEY_ID, ASC_ISSUER_ID, and ASC_KEY_PATH before uploading."
      )
    end
    return {}
  end

  UI.user_error!("ASC_KEY_PATH does not exist: #{key_path}") if required && !File.file?(key_path)
  return {} unless File.file?(key_path)

  {
    api_key: app_store_connect_api_key(
      key_id: key_id,
      issuer_id: issuer_id,
      key_filepath: key_path,
      duration: 1200,
      in_house: false
    )
  }
end

def exported_ipa_path
  explicit_path = ENV["IPA_PATH"].to_s
  return explicit_path unless explicit_path.empty?

  Dir[File.join(DEFAULT_EXPORT_PATH, "*.ipa")].sort.first
end

def review_information_options
  info = {}
  notes_path = File.join(REVIEW_INFORMATION_PATH, "notes.txt")
  info[:notes] = File.read(notes_path) if File.file?(notes_path)

  {
    first_name: "APP_REVIEW_CONTACT_FIRST_NAME",
    last_name: "APP_REVIEW_CONTACT_LAST_NAME",
    phone_number: "APP_REVIEW_CONTACT_PHONE",
    email_address: "APP_REVIEW_CONTACT_EMAIL"
  }.each do |key, env_name|
    value = ENV[env_name].to_s.strip
    info[key] = value unless value.empty?
  end

  info
end

def run_release_script!(relative_path, failure_message)
  script_path = File.join(PROJECT_ROOT, relative_path)
  return if system(Shellwords.escape(script_path))

  UI.user_error!(failure_message)
end

def validate_app_store_metadata!
  run_release_script!(
    "Scripts/validate_app_store_metadata.sh",
    "App Store metadata validation failed."
  )
end

def validate_screenshot_sync!
  run_release_script!(
    "Scripts/validate_screenshot_sync.sh",
    "Screenshot sync validation failed."
  )
end

def validate_app_privacy_details!
  run_release_script!(
    "Scripts/validate_app_privacy_details.sh",
    "App Privacy Details validation failed."
  )
end

def validate_privacy_surface!
  run_release_script!(
    "Scripts/validate_privacy_surface.sh",
    "Privacy surface validation failed."
  )
end

def validate_app_store_questionnaires!
  run_release_script!(
    "Scripts/validate_app_store_questionnaires.sh",
    "App Store questionnaire validation failed."
  )
end

def validate_app_review_contact!
  run_release_script!(
    "Scripts/validate_app_review_contact.sh",
    "Set valid APP_REVIEW_CONTACT_* values before uploading metadata or submitting for review."
  )
end

def validate_app_store_export!
  run_release_script!(
    "Scripts/validate_app_store_export.sh",
    "App Store archive/export validation failed."
  )
end

def verify_app_store_connect_state!
  run_release_script!(
    "Scripts/check_app_store_connect_state.sh",
    "App Store Connect app, version, or selected build preflight failed."
  )
end

def submission_information_options
  {
    export_compliance_uses_encryption: false,
    content_rights_contains_third_party_content: false
  }
end

def confirm_submit_for_review!
  return if ENV["CONFIRM_SUBMIT_FOR_REVIEW"].to_s == "1"

  UI.user_error!(
    "Set CONFIRM_SUBMIT_FOR_REVIEW=1 only after the App Store Connect build, metadata, screenshots, " \
    "privacy details, age rating, and App Review contact details are final."
  )
end

def confirm_upload_app_privacy!
  return if ENV["CONFIRM_UPLOAD_APP_PRIVACY"].to_s == "1"

  UI.user_error!(
    "Set CONFIRM_UPLOAD_APP_PRIVACY=1 only after AppStore/app_privacy_details.json has been reviewed " \
    "against the App Privacy answers."
  )
end

opt_out_usage
default_platform(:ios)

platform :ios do
  desc "Run the full local release verification gate"
  lane :verify do
    sh(Shellwords.escape(File.join(PROJECT_ROOT, "Scripts/verify_release.sh")))
  end

  desc "Audit App Store readiness and report blockers"
  lane :readiness do
    readiness_script = File.join(PROJECT_ROOT, "Scripts/check_app_store_readiness.sh")
    unless system(readiness_script)
      UI.important("Readiness blockers remain; see audit output above.")
    end
  end

  desc "Upload App Store Connect metadata and screenshots without submitting"
  lane :metadata do
    validate_app_store_metadata!
    validate_screenshot_sync!
    validate_app_store_questionnaires!
    validate_app_review_contact!

    deliver(
      app_store_connect_credentials(required: false).merge(
        app_identifier: APP_IDENTIFIER,
        app_version: APP_VERSION,
        primary_category: PRIMARY_CATEGORY,
        secondary_category: SECONDARY_CATEGORY,
        app_review_information: review_information_options,
        metadata_path: File.join(PROJECT_ROOT, "fastlane/metadata"),
        screenshots_path: File.join(PROJECT_ROOT, "fastlane/screenshots"),
        skip_binary_upload: true,
        skip_app_version_update: true,
        submit_for_review: false,
        automatic_release: false,
        force: true,
        overwrite_screenshots: true
      )
    )
  end

  desc "Verify App Store Connect app record, version, and processed TestFlight build"
  lane :app_store_connect_state do
    sh(Shellwords.escape(File.join(PROJECT_ROOT, "Scripts/check_app_store_connect_state.sh")))
  end

  desc "Upload App Privacy Details to App Store Connect"
  lane :privacy_details do
    confirm_upload_app_privacy!
    validate_privacy_surface!
    validate_app_privacy_details!
    validate_app_store_questionnaires!

    username = ENV["FASTLANE_USER"].to_s.strip
    UI.user_error!("Set FASTLANE_USER to the Apple ID used for App Store Connect before uploading App Privacy Details") if username.empty?

    options = {
      username: username,
      app_identifier: APP_IDENTIFIER,
      json_path: APP_PRIVACY_DETAILS_PATH,
      skip_publish: ENV["APP_PRIVACY_SKIP_PUBLISH"].to_s == "1"
    }

    team_id = ENV["FASTLANE_ITC_TEAM_ID"].to_s.strip
    options[:team_id] = team_id unless team_id.empty?

    team_name = ENV["FASTLANE_ITC_TEAM_NAME"].to_s.strip
    options[:team_name] = team_name unless team_name.empty?

    upload_app_privacy_details_to_app_store(options)
  end

  desc "Submit an already uploaded App Store Connect build for App Review"
  lane :submit_review do
    confirm_submit_for_review!
    validate_app_store_metadata!
    validate_screenshot_sync!
    validate_privacy_surface!
    validate_app_privacy_details!
    validate_app_store_questionnaires!
    validate_app_review_contact!

    build_number = ENV["APP_STORE_BUILD_NUMBER"].to_s.strip
    UI.user_error!("Set APP_STORE_BUILD_NUMBER to the processed App Store Connect build number before submitting for review") if build_number.empty?
    verify_app_store_connect_state!

    deliver(
      app_store_connect_credentials(required: true).merge(
        app_identifier: APP_IDENTIFIER,
        app_version: APP_VERSION,
        build_number: build_number,
        primary_category: PRIMARY_CATEGORY,
        secondary_category: SECONDARY_CATEGORY,
        app_review_information: review_information_options,
        submission_information: submission_information_options,
        metadata_path: File.join(PROJECT_ROOT, "fastlane/metadata"),
        screenshots_path: File.join(PROJECT_ROOT, "fastlane/screenshots"),
        skip_binary_upload: true,
        submit_for_review: true,
        automatic_release: false,
        force: true,
        overwrite_screenshots: true
      )
    )
  end

  desc "Create a signed App Store archive after signing is configured"
  lane :archive do
    team_id = ENV["DEVELOPMENT_TEAM_ID"]
    UI.user_error!("Set DEVELOPMENT_TEAM_ID before running ios archive") if team_id.to_s.empty?

    allow_updates = ENV["ALLOW_PROVISIONING_UPDATES"] || "1"
    archive_script = File.join(PROJECT_ROOT, "Scripts/archive_app_store.sh")
    sh(
      "DEVELOPMENT_TEAM_ID=#{Shellwords.escape(team_id)} " \
      "ALLOW_PROVISIONING_UPDATES=#{Shellwords.escape(allow_updates)} " \
      "#{Shellwords.escape(archive_script)}"
    )
  end

  desc "Upload the signed App Store IPA to TestFlight without external distribution"
  lane :upload_testflight do
    credential_options = app_store_connect_credentials(required: true)
    ipa_path = exported_ipa_path

    unless ipa_path && File.file?(ipa_path)
      UI.message("No exported IPA found; creating one with Scripts/archive_app_store.sh.")

      team_id = ENV["DEVELOPMENT_TEAM_ID"]
      UI.user_error!("Set DEVELOPMENT_TEAM_ID before running ios upload_testflight") if team_id.to_s.empty?

      allow_updates = ENV["ALLOW_PROVISIONING_UPDATES"] || "1"
      archive_script = File.join(PROJECT_ROOT, "Scripts/archive_app_store.sh")
      sh(
        "DEVELOPMENT_TEAM_ID=#{Shellwords.escape(team_id)} " \
        "ALLOW_PROVISIONING_UPDATES=#{Shellwords.escape(allow_updates)} " \
        "#{Shellwords.escape(archive_script)}"
      )
      ipa_path = exported_ipa_path
    end

    UI.user_error!("No exported IPA found under #{DEFAULT_EXPORT_PATH}; set IPA_PATH explicitly.") unless ipa_path && File.file?(ipa_path)
    ENV["IPA_PATH"] = ipa_path
    validate_app_store_export!

    upload_to_testflight(
      credential_options.merge(
        app_identifier: APP_IDENTIFIER,
        ipa: ipa_path,
        skip_waiting_for_build_processing: true,
        distribute_external: false,
        notify_external_testers: false,
        changelog: ENV["TESTFLIGHT_CHANGELOG"] || "Initial FreePrint Studio TestFlight build."
      )
    )
  end
end
