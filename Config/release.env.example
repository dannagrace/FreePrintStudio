# FreePrint Studio release environment template.
# Do not commit a filled release.env file or App Store Connect private keys.

DEVELOPMENT_TEAM_ID=ABCDE12345
ALLOW_PROVISIONING_UPDATES=1

# Option A: Fastlane App Store Connect API JSON.
# APP_STORE_CONNECT_API_KEY_JSON=/absolute/path/to/fastlane-api-key.json

# Option B: App Store Connect API key triplet.
ASC_KEY_ID=XXXXXXXXXX
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000
ASC_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXXXX.p8

# App Store Review contact details.
# Put real contact details only in your untracked Config/release.env or shell environment.
APP_REVIEW_CONTACT_FIRST_NAME=YOUR_FIRST_NAME
APP_REVIEW_CONTACT_LAST_NAME=YOUR_LAST_NAME
APP_REVIEW_CONTACT_PHONE=+1-555-0100
APP_REVIEW_CONTACT_EMAIL=review-contact@example.com

# Optional overrides.
# IPA_PATH=/absolute/path/to/FreePrintStudio.ipa
TESTFLIGHT_CHANGELOG=Initial FreePrint Studio TestFlight build.

# Final App Review submission guard. Set only when the uploaded build is processed
# and every App Store Connect field has been reviewed.
# APP_STORE_BUILD_NUMBER=1
# CONFIRM_SUBMIT_FOR_REVIEW=1
