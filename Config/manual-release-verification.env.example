# FreePrint Studio manual release verification evidence.
# Copy to Config/manual-release-verification.env and fill after testing on real devices.
# Keep the filled file out of git.

# Person or team that performed the manual release verification.
MANUAL_VERIFIER_NAME=""

# Real iPhone/iOS validation. Use a physical iPhone model, not a Simulator.
# Use lowercase pass for completed checks.
MANUAL_REAL_IPHONE_MODEL=""
MANUAL_REAL_IPHONE_IOS_VERSION=""
MANUAL_REAL_IPHONE_TEST_DATE=""
MANUAL_REAL_IPHONE_PHOTOS_IMPORT=""
MANUAL_REAL_IPHONE_PDF_EXPORT=""
MANUAL_REAL_IPHONE_PRINT_SHEET=""

# Real AirPrint or production-equivalent print validation.
MANUAL_AIRPRINT_TEST_DATE=""
MANUAL_AIRPRINT_PRINTER=""
MANUAL_AIRPRINT_EXACT_SIZE=""

# TestFlight validation on a physical device after upload processing.
MANUAL_TESTFLIGHT_BUILD_NUMBER=""
MANUAL_TESTFLIGHT_DEVICE=""
MANUAL_TESTFLIGHT_TEST_DATE=""
MANUAL_TESTFLIGHT_INSTALL=""
MANUAL_TESTFLIGHT_PRINT_WORKFLOW=""
